#
# usbip-attach: keep the macOS host's USB Wi-Fi dongle attached over USB/IP.
# Kernel command line: godseon.usbip=HOST[:PORT]/BUSID, where HOST may be "gw"
# for the Mac, the gateway of the VZNAT link (eth0); PORT defaults to 9408.
# Example: godseon.usbip=gw/1-1
# Without the option this does nothing.

BB=/usr/bin/busybox
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
export PATH

log() {
    echo "usbip-attach: $*" >/dev/kmsg 2>/dev/null || true
}

spec=""
for opt in $($BB cat /proc/cmdline); do
    case "$opt" in
    godseon.usbip=*) spec=${opt#godseon.usbip=} ;;
    esac
done
[ -n "$spec" ] || exec $BB sleep 2147483647

hostport=${spec%%/*}
busid=${spec#*/}
host=${hostport%%:*}
port=9408
case "$hostport" in
*:*) port=${hostport#*:} ;;
esac

VZNAT_IFACE=${THRURNDIS_VZNAT_IFACE:-eth0}

/sbin/modprobe -q vhci_hcd 2>/dev/null || log "vhci_hcd did not load"
# usbip records each attach under /var/run/vhci_hcd and reports a failure (after
# attaching) when it cannot.
$BB mkdir -p /var/run/vhci_hcd

VHCI_STATUS=/sys/devices/platform/vhci_hcd.0/status

# Checked every 3 s for the life of the VM, so builtins only: the vhci status
# lines read "hub port sta spd dev sockfd local_busid", sta 006 = in use.
attached() {
    if [ -r "$VHCI_STATUS" ]; then
        { while read -r _hub _port sta _rest; do
            [ "$sta" = 006 ] && return 0
        done <"$VHCI_STATUS"; } 2>/dev/null
        return 1
    fi
    usbip port 2>/dev/null | $BB grep -q "Port in Use"
}

failures=0
while :; do
    if ! attached; then
        target=$host
        if [ "$target" = gw ]; then
            # Only eth0's: once Wi-Fi is up, wlan0 has a default route of its own.
            target=$(ip -4 route show default dev "$VZNAT_IFACE" 2>/dev/null | $BB awk '{ print $2 == "via" ? $3 : $2; exit }')
        fi
        if [ -n "$target" ]; then
            if usbip --tcp-port "$port" attach -r "$target" -b "$busid" >/tmp/usbip-attach.log 2>&1; then
                log "attached $busid from $target:$port"
                failures=0
            else
                failures=$((failures + 1))
                # log the first failure and then every 20th, not every 3 seconds
                if [ "$failures" -eq 1 ] || [ $((failures % 20)) -eq 0 ]; then
                    log "attach $busid from $target:$port failed ($failures): $($BB tr '\n' ' ' </tmp/usbip-attach.log)"
                fi
            fi
        fi
    fi
    $BB sleep 3
done
